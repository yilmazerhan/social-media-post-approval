# Copy to .env and adjust. Never commit a filled-in .env: secrets come from the vault in
# deployed environments (ARCHITECTURE.md 12.4).

KSA_BASE_URL=http://localhost:8080
KSA_PORT=8080
# Actuator listens here; the ingress must not publish this port
KSA_MANAGEMENT_PORT=8081

# Database
KSA_DB_URL=jdbc:postgresql://localhost:5432/ksa
KSA_DB_USERNAME=ksa
KSA_DB_PASSWORD=ksa

# Redis (sessions, rate limiting)
KSA_REDIS_HOST=localhost
KSA_REDIS_PORT=6379

# Authentication — both methods are independently switchable
KSA_AUTH_LOCAL_ENABLED=true
KSA_AUTH_SAML_ENABLED=false
KSA_SAML_METADATA_URI=
KSA_SAML_JIT_MODE=JIT_CREATE

# Object storage
KSA_STORAGE_PROVIDER=s3
KSA_STORAGE_ENDPOINT=http://localhost:9000
KSA_STORAGE_ACCESS_KEY=minioadmin
KSA_STORAGE_SECRET_KEY=minioadmin

# Mail
KSA_MAIL_HOST=localhost
KSA_MAIL_PORT=1025
KSA_MAIL_FROM=no-reply@kron.local

# AI content review — off until the data flow is approved (ARCHITECTURE.md 11.4)
KSA_AI_ENABLED=false
KSA_AI_PROVIDER=noop
KSA_AI_API_KEY=
