# Copy to .env and fill in real values. Never commit .env.
# Full description of every variable: CONFIGURATION.md
# Any variable may instead be supplied as <NAME>_FILE, pointing at a file
# whose trimmed contents become the value (Docker/Podman secrets).

# ---- 1. Application --------------------------------------------------------
NODE_ENV=development
APP_NAME="Content Approval"
APP_URL=http://localhost:3000
PORT=3000
APP_TIMEZONE=Europe/Istanbul
LOG_LEVEL=info
LOG_FORMAT=pretty
TRUST_PROXY=true
TRUST_PROXY_HOPS=1

# ---- 2. Database ------------------------------------------------------------
DATABASE_URL=postgresql://ca:ca_dev_password@localhost:5432/content_approval?schema=public
DATABASE_POOL_SIZE=10
DATABASE_CONNECT_TIMEOUT=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_SSL=false
# DATABASE_SSL_CA_FILE=/run/secrets/db_ca.pem

# Only read by the containerised `postgres` service in docker-compose.yml
# (DEPLOYMENT.md §4) — never by the app itself. Keep these in sync with
# the credentials embedded in DATABASE_URL above. Not needed at all
# against a customer-managed PostgreSQL server.
POSTGRES_USER=ca
POSTGRES_PASSWORD=ca_dev_password
POSTGRES_DB=content_approval

# ---- 3. Security and session ------------------------------------------------
# openssl rand -base64 48
SESSION_SECRET=replace-this-with-32-or-more-random-characters-before-running
SESSION_COOKIE_NAME=ca_session
SESSION_ABSOLUTE_TIMEOUT_MINUTES=480
SESSION_IDLE_TIMEOUT_MINUTES=60
SESSION_REVOKE_ON_ROLE_CHANGE=false
# COOKIE_SECURE=true
CSRF_COOKIE_NAME=ca_csrf
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MINUTES=15
RATE_LIMIT_MUTATION_MAX=120
LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION_MINUTES=15
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPER=true
PASSWORD_REQUIRE_LOWER=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SYMBOL=false
PASSWORD_HISTORY_COUNT=5
PASSWORD_MAX_AGE_DAYS=0
PASSWORD_RESET_TTL_MINUTES=60
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ---- 4. Authentication providers --------------------------------------------
AUTH_LOCAL_ENABLED=true
AUTH_SAML_ENABLED=false
# SAML_ENTITY_ID=https://approval.corp.local/saml
# SAML_ACS_URL=https://approval.corp.local/api/v1/auth/saml/acs
# SAML_IDP_ENTITY_ID=
# SAML_IDP_SSO_URL=
# SAML_IDP_SLO_URL=
# SAML_IDP_CERTIFICATE=
# SAML_IDP_METADATA_FILE=
# SAML_SP_PRIVATE_KEY_FILE=
# SAML_SP_CERTIFICATE_FILE=
SAML_WANT_ASSERTIONS_SIGNED=true
SAML_WANT_RESPONSE_SIGNED=true
SAML_SIGNATURE_ALGORITHM=sha256
SAML_CLOCK_SKEW_SECONDS=60
SAML_JIT_PROVISIONING=true
SAML_JIT_DEFAULT_ROLE=EMPLOYEE
SAML_JIT_FORBID_ADMIN=true
SAML_ALLOW_LOCAL_LINK=false
SAML_ATTR_EMAIL=http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress
SAML_ATTR_FIRST_NAME=http://schemas.xmlsoap.org/ws/2005/05/identity/claims/givenname
SAML_ATTR_LAST_NAME=http://schemas.xmlsoap.org/ws/2005/05/identity/claims/surname
SAML_ATTR_DISPLAY_NAME=http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name
SAML_ATTR_OBJECT_ID=http://schemas.microsoft.com/identity/claims/objectidentifier
SAML_ATTR_GROUPS=http://schemas.microsoft.com/ws/2008/06/identity/claims/groups
SAML_ATTR_DEPARTMENT=department
SAML_ATTR_JOB_TITLE=jobtitle

# ---- 5. SMTP / email ---------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
SMTP_FROM="Content Approval <no-reply@example.local>"
# SMTP_REPLY_TO=
SMTP_TLS=starttls
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_TIMEOUT_MS=15000
EMAIL_ENABLED=false
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_SECONDS=60
ALLOW_INSECURE_SMTP=false

# ---- 6. Storage and media -----------------------------------------------------
STORAGE_PATH=./data/uploads
# STORAGE_TMP_PATH=./data/uploads/tmp
TLS_CERT_DIR=./certs
MAX_UPLOAD_SIZE=104857600
MAX_IMAGE_SIZE=10485760
MAX_ATTACHMENTS_PER_POST=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/quicktime
THUMBNAIL_WIDTH=480
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
UPLOAD_TMP_TTL_MINUTES=240

# ---- 7. Worker and jobs ---------------------------------------------------------
WORKER_ENABLED=true
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=2000
# WORKER_ID=
JOB_STALE_AFTER_SECONDS=900
JOB_DEFAULT_MAX_ATTEMPTS=5
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30

# ---- 8. Workflow defaults (seed SystemSetting on first run) -------------------
SLA_DEFAULT_MINUTES=1440
SLA_WARNING_PERCENT=75
SLA_ESCALATION_MINUTES=2880
DIGEST_HOUR=9
DIGEST_ENABLED=true
RETENTION_DAYS=30
RETENTION_ATTACHMENT_DAYS=30
RETENTION_NOTIFICATION_DAYS=90
RETENTION_EMAIL_LOG_DAYS=180
RETENTION_AUDIT_LOG_DAYS=730
RETENTION_JOB_DAYS=30
RETENTION_DRY_RUN=true
POST_MAX_CHARACTERS=2200
AUTOSAVE_INTERVAL_SECONDS=3
COMMENT_MAX_CHARACTERS=2000
COMMENT_EDIT_WINDOW_MINUTES=30

# ---- Next.js -------------------------------------------------------------------
NEXT_TELEMETRY_DISABLED=1
